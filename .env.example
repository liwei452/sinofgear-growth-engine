# Development only. Production secrets must differ and must never be committed.
POSTGRES_DB=sinofgear
POSTGRES_USER=sinofgear
POSTGRES_PASSWORD=sinofgear_dev_password
DATABASE_URL=postgresql://sinofgear:sinofgear_dev_password@db:5432/sinofgear
REDIS_PASSWORD=sinofgear_redis_dev_password
REDIS_URL=redis://:sinofgear_redis_dev_password@redis:6379/0
# Optional shared cache. When set, read endpoints use Redis; otherwise in-process cache is used.
CACHE_URL=redis://:sinofgear_redis_dev_password@redis:6379/1
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
VITE_ASSET_DOWNLOAD_ORIGINS=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev_secret
MINIO_BUCKET=sinofgear-assets
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_PUBLIC_SECURE=false
OBJECT_STORAGE_BACKEND=minio
ASSET_MAX_UPLOAD_BYTES=262144000
ASSET_SPOOL_MEMORY_BYTES=8388608
DJANGO_SECRET_KEY=development-only-django-secret-key-change-me
SEED_ADMIN_PASSWORD=development-only-admin-password
# Product content generation. Fake/offline is the safe default.
PRODUCT_AI_PROVIDER=fake
PRODUCT_AI_MODEL=fake-v1
# To enable the official DeepSeek API, set PRODUCT_AI_PROVIDER=deepseek,
# PRODUCT_AI_MODEL=deepseek-chat, and provide DEEPSEEK_API_KEY only in the server environment.
DEEPSEEK_API_KEY=

# Official anonymous TED procurement discovery. No API key is required.
TED_DISCOVERY_TIMEOUT_SECONDS=15
TED_DISCOVERY_MAX_RESPONSE_BYTES=2000000

# Official anonymous UK Contracts Finder procurement discovery. No API key is required.
CONTRACTS_FINDER_DISCOVERY_TIMEOUT_SECONDS=15
CONTRACTS_FINDER_DISCOVERY_MAX_RESPONSE_BYTES=2000000

# Aggregate public trade snapshots. DISABLED is the safe default; FIXTURE is test-only.
PUBLIC_TRADE_PROVIDER_MODE=DISABLED

# Official social connections are disabled by default. Keep credentials empty in source control.
SOCIAL_OAUTH_ALLOWED_ORIGINS=
SOCIAL_OAUTH_TOKEN_KEY_REFERENCE=
SOCIAL_OAUTH_TOKEN_KEY_VERSION=v1
META_OAUTH_ENABLED=false
META_CLIENT_ID=
META_CLIENT_SECRET_REFERENCE=
META_OAUTH_REDIRECT_URI=
META_API_VERSION=v23.0
META_AUDITED=false
TIKTOK_OAUTH_ENABLED=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET_REFERENCE=
TIKTOK_OAUTH_REDIRECT_URI=
TIKTOK_AUDITED=false
LINKEDIN_OAUTH_ENABLED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET_REFERENCE=
LINKEDIN_OAUTH_REDIRECT_URI=
LINKEDIN_API_VERSION=
LINKEDIN_AUDITED=false
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET_REFERENCE=
YOUTUBE_OAUTH_REDIRECT_URI=
YOUTUBE_AUDITED=false

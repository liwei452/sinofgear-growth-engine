  /api/v1/analytics/channel-summary:
    get:
      operationId: analytics_channel_summary
      description: Aggregate-only click counts grouped deterministically by date,
        campaign, platform, country and product. Date ranges contain at most 366 calendar
        days and reference at most 200 publishing tasks; no raw events or hashes are
        returned.
      parameters:
      - in: query
        name: campaign
        schema:
          type: string
          format: uuid
      - in: query
        name: country
        schema:
          type: string
      - in: query
        name: end
        schema:
          type: string
          format: date
        required: true
      - in: query
        name: limit
        schema:
          type: integer
          minimum: 1
          maximum: 100
      - in: query
        name: offset
        schema:
          type: integer
          minimum: 0
      - in: query
        name: page_size
        schema:
          type: integer
          minimum: 1
          maximum: 100
      - in: query
        name: platform
        schema:
          type: string
          format: uuid
      - in: query
        name: product
        schema:
          type: string
          format: uuid
      - in: query
        name: start
        schema:
          type: string
          format: date
        required: true
      tags:
      - Analytics
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ChannelSummaryEnvelope'
          description: ''
  /api/v1/assets:
    get:
      operationId: assets_list
      parameters:
      - in: query
        name: cursor
        schema:
          type: string
        description: Opaque stable cursor; generated links preserve all active filters.
      - in: query
        name: page_size
        schema:
          type: integer
          minimum: 1
          maximum: 50
      - in: query
        name: product
        schema:
          type: string
          format: uuid
        description: Organization-scoped product UUID. May be supplied at most once.
      - in: query
        name: status
        schema:
          type: string
          enum:
          - ACTIVE
          - ARCHIVED
        description: Exact asset status. May be supplied at most once; invalid values
          return 400.
      - in: query
        name: tag
        schema:
          type: string
        description: Exact case-sensitive tag. May be supplied at most once.
      - in: query
        name: type
        schema:
          type: string
          enum:
          - DOCUMENT
          - IMAGE
          - VIDEO
        description: Exact asset type. May be supplied at most once; invalid values
          return 400.
      tags:
      - Assets
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssetList'
          description: ''
        '400':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssetValidationError'
          description: ''
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssetError'
          description: ''
    post:
      operationId: assets_create
      tags:
      - Assets
      requestBody:
        content:
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AssetUpload'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AssetUpload'
        required: true
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MaterialAsset'
          description: ''
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MaterialAsset'
          description: ''
        '400':
          description: The request could not be completed.
          content:
            application/json:
              schema:
                allOf:
                - $ref: '#/components/schemas/ApiError'
                - $ref: '#/components/schemas/AssetValidationError'
        '403':
          description: The request could not be completed.
          content:

  /api/v1/publish-calendar:
    get:
      operationId: api_v1_publish_calendar_retrieve
      description: Returns at most 200 tasks ordered by UTC scheduled time and ID,
        grouped into IANA local display dates. metadata.truncated reports whether
        more matching database rows exist.
      parameters:
      - in: query
        name: account
        schema:
          type: string
          format: uuid
      - in: query
        name: campaign
        schema:
          type: string
          format: uuid
      - in: query
        name: country
        schema:
          type: string
      - in: query
        name: end
        schema:
          type: string
          format: date-time
        required: true
      - in: query
        name: platform
        schema:
          type: string
          format: uuid
      - in: query
        name: product
        schema:
          type: string
          format: uuid
      - in: query
        name: start
        schema:
          type: string
          format: date-time
        required: true
      - in: query
        name: status
        schema:
          type: string
          enum:
          - CANCELED
          - FAILED
          - QUEUED
          - RUNNING
          - SCHEDULED
          - SUBMISSION_UNKNOWN
          - SUBMITTED
          - SUCCEEDED
      - in: query
        name: timezone
        schema:
          type: string
        description: IANA timezone used only for local-date grouping.
        required: true
      tags:
      - PublishTasks
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PublishCalendarEnvelope'
          description: ''

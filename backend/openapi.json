openapi: 3.0.3
info:
  title: SinofGear Growth Engine API
  version: v1
paths:
  /api/v1/ai-runs:
    get:
      operationId: ai_runs_list
      parameters:
      - in: query
        name: cursor
        schema:
          type: string
      - in: query
        name: job
        schema:
          type: string
          format: uuid
      - in: query
        name: page_size
        schema:
          type: integer
          minimum: 1
          maximum: 50
      - in: query
        name: status
        schema:
          type: string
          enum:
          - CANCELED
          - FAILED
          - RUNNING
          - SUCCEEDED
      tags:
      - AIRuns
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AIRunList'
          description: ''
        '400':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AIRunValidationError'
          description: ''
  /api/v1/ai-runs/{run_id}:
    get:
      operationId: ai_runs_retrieve
      parameters:
      - in: path
        name: run_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - AIRuns

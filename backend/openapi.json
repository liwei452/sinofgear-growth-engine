              $ref: '#/components/schemas/AIProviderConfigWrite'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AIProviderConfigWrite'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AIProviderConfigWrite'
        required: true
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AIProviderConfig'
          description: ''
        '400':
          description: The request is invalid.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Authentication is required.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: The request is forbidden or failed CSRF validation.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
    delete:
      operationId: api_v1_ai_provider_config_destroy
      tags:
      - AIProviderConfig
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '204':
          description: No response body
        '400':
          description: The request is invalid.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '401':
          description: Authentication is required.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: The request is forbidden or failed CSRF validation.
          content:
            application/json:

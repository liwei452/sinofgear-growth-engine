  /api/v1/tracking-links:
    get:
      operationId: tracking_links_list
      parameters:
      - in: query
        name: cursor
        schema:
          type: string
      - in: query
        name: page_size
        schema:
          type: integer
          minimum: 1
          maximum: 50
      tags:
      - TrackingLinks
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TrackingCursorEnvelope'
          description: ''
    post:
      operationId: tracking_links_create
      parameters:
      - in: header
        name: Idempotency-Key
        schema:
          type: string
        description: Organization-scoped key of 1-128 visible ASCII characters.
        required: true
      tags:
      - TrackingLinks
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TrackingLinkCreate'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/TrackingLinkCreate'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/TrackingLinkCreate'
        required: true
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TrackingLink'
          description: ''
        '400':
          description: The request could not be completed.
          content:
            application/json:
              schema:
                allOf:
                - $ref: '#/components/schemas/ApiError'
                - $ref: '#/components/schemas/TrackingValidationError'
        '409':
          description: The request could not be completed.
          content:
            application/json:
              schema:
                allOf:
                - $ref: '#/components/schemas/ApiError'
                - $ref: '#/components/schemas/TrackingError'
        '401':
          description: Authentication is required.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
        '403':
          description: The request is forbidden or failed CSRF validation.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApiError'
  /api/v1/tracking-links/{link_id}:
    get:
      operationId: tracking_links_retrieve
      parameters:
      - in: path
        name: link_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - TrackingLinks
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TrackingLink'
          description: ''
  /r/{code}:
    get:
      operationId: tracking_public_redirect
      parameters:
      - in: path
        name: code
        schema:
          type: string
        required: true
      tags:
      - ShortLinks
      security:
      - {}
      responses:
        '302':
          description: Recorded click; redirect to the exact canonical tracking URL.
        '400':
          description: Invalid privacy metadata; no click and no redirect.
        '404':
          description: Unknown, disabled, or inconsistent link.
        '503':
          description: Click could not be safely recorded; no redirect.
